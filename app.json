{
  "expo": {
    "name": "Budge",
    "slug": "my-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/budge-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/budge-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00452E",
        "foregroundImage": "./assets/images/budge-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saad123under.budgetapp",
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/budge-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00452E",
          "image": "./assets/images/budge-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "yolosaads-team",
    "extra": {
      "eas": {
        "projectId": "c74f7f64-2c64-4021-b353-837b4b36d4e4"
      }
    }
  }
}
